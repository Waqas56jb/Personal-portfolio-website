# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored — never commit real secrets.
# On Vercel, set these in Project Settings → Environment Variables instead.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Origins allowed to call this API, comma separated.
# Entries may contain `*` — e.g. https://*.vercel.app lets preview deploys through.
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://waqas-naveed.vercel.app,https://*.vercel.app

# --- Mail (Gmail SMTP) -----------------------------------------------------
# MAIL_APP_PASSWORD is a Google "App Password", not your account password.
# Create one at: https://myaccount.google.com/apppasswords
MAIL_USER=waqas56jb@gmail.com
MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where enquiry notifications land (defaults to MAIL_USER)
MAIL_TO=waqas56jb@gmail.com

# Send an automatic acknowledgement back to the person who filled the form
SEND_AUTO_REPLY=true

# --- OpenAI Realtime voice agent -------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
